+/* --- Cursor track (Fondaro patch, see gsr_cursor_track_enabled in utils.h) ---
+   One line per change: the hotspot position in stream pixels, the cursor shape (its pixels as RGBA in
+   base64 the first time a shape is seen, by a hash after that), hidden/shown, and the crop. Called from
+   the PipeWire thread for every dequeued buffer, so no position is lost when gsr skips a frame. */
+
+static void cursor_track_base64(const uint8_t *data, size_t size, char *out) {
+    static const char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    size_t o = 0;
+    for(size_t i = 0; i < size; i += 3) {
+        const uint32_t b0 = data[i];
+        const uint32_t b1 = i + 1 < size ? data[i + 1] : 0;
+        const uint32_t b2 = i + 2 < size ? data[i + 2] : 0;
+        const uint32_t v = (b0 << 16) | (b1 << 8) | b2;
+        out[o++] = alphabet[(v >> 18) & 63];
+        out[o++] = alphabet[(v >> 12) & 63];
+        out[o++] = i + 1 < size ? alphabet[(v >> 6) & 63] : '=';
+        out[o++] = i + 2 < size ? alphabet[v & 63] : '=';
+    }
+    out[o] = '\0';
+}
+
+/* Byte order of each 4-byte pixel as indices of r, g, b, a (-1: opaque). False if unsupported. */
+static bool cursor_track_layout(uint32_t format, int idx[4]) {
+    switch(format) {
+        case SPA_VIDEO_FORMAT_RGBA: idx[0] = 0; idx[1] = 1; idx[2] = 2; idx[3] = 3;  return true;
+        case SPA_VIDEO_FORMAT_BGRA: idx[0] = 2; idx[1] = 1; idx[2] = 0; idx[3] = 3;  return true;
+        case SPA_VIDEO_FORMAT_ARGB: idx[0] = 1; idx[1] = 2; idx[2] = 3; idx[3] = 0;  return true;
+        case SPA_VIDEO_FORMAT_ABGR: idx[0] = 3; idx[1] = 2; idx[2] = 1; idx[3] = 0;  return true;
+        case SPA_VIDEO_FORMAT_RGBx: idx[0] = 0; idx[1] = 1; idx[2] = 2; idx[3] = -1; return true;
+        case SPA_VIDEO_FORMAT_BGRx: idx[0] = 2; idx[1] = 1; idx[2] = 0; idx[3] = -1; return true;
+        default: return false;
+    }
+}
+
+static void cursor_track_shape(double t, const struct spa_meta_cursor *cursor, const struct spa_meta_bitmap *bitmap) {
+    static uint64_t seen[512];
+    static size_t num_seen = 0;
+    static uint64_t current = 0;
+    static bool current_valid = false;
+    static bool warned_format = false;
+
+    const uint32_t w = bitmap->size.width, h = bitmap->size.height;
+    if(w == 0 || h == 0) {
+        /* An empty sprite: the cursor is there but draws nothing (e.g. hidden while typing) */
+        if(!current_valid || current != 0) {
+            gsr_cursor_track_printf("{\"t\":%.6f,\"shape\":\"empty\"}", t);
+            current = 0;
+            current_valid = true;
+        }
+        return;
+    }
+
+    int idx[4];
+    if(w > 1024 || h > 1024 || bitmap->offset < sizeof(*bitmap) || !cursor_track_layout(bitmap->format, idx)) {
+        if(!warned_format) {
+            gsr_cursor_track_printf("{\"warning\":\"unsupported cursor bitmap: %ux%u format %u\"}", w, h, bitmap->format);
+            warned_format = true;
+        }
+        return;
+    }
+
+    const int32_t stride = bitmap->stride > 0 ? bitmap->stride : (int32_t)(w * 4);
+    const uint8_t *src = SPA_MEMBER(bitmap, bitmap->offset, const uint8_t);
+    const size_t rgba_size = (size_t)w * h * 4;
+    uint8_t *rgba = malloc(rgba_size);
+    if(!rgba)
+        return;
+    for(uint32_t y = 0; y < h; ++y) {
+        const uint8_t *row = src + (size_t)y * stride;
+        for(uint32_t x = 0; x < w; ++x) {
+            const uint8_t *px = row + x * 4;
+            uint8_t *out = rgba + ((size_t)y * w + x) * 4;
+            out[0] = px[idx[0]];
+            out[1] = px[idx[1]];
+            out[2] = px[idx[2]];
+            out[3] = idx[3] >= 0 ? px[idx[3]] : 255;
+        }
+    }
+
+    /* FNV-1a over the size, hotspot and pixels */
+    uint64_t hash = 1469598103934665603ULL;
+    const int32_t header[4] = { (int32_t)w, (int32_t)h, cursor->hotspot.x, cursor->hotspot.y };
+    for(size_t i = 0; i < sizeof(header); ++i) { hash ^= ((const uint8_t*)header)[i]; hash *= 1099511628211ULL; }
+    for(size_t i = 0; i < rgba_size; ++i) { hash ^= rgba[i]; hash *= 1099511628211ULL; }
+    if(hash == 0)
+        hash = 1;
+
+    bool known = false;
+    for(size_t i = 0; i < num_seen; ++i) {
+        if(seen[i] == hash) {
+            known = true;
+            break;
+        }
+    }
+
+    if(!known) {
+        char *b64 = malloc(((rgba_size + 2) / 3) * 4 + 1);
+        if(b64) {
+            cursor_track_base64(rgba, rgba_size, b64);
+            gsr_cursor_track_printf("{\"t\":%.6f,\"shape\":\"%016" PRIx64 "\",\"w\":%u,\"h\":%u,\"hotspot\":[%d,%d],\"rgba\":\"%s\"}",
+                t, hash, w, h, cursor->hotspot.x, cursor->hotspot.y, b64);
+            free(b64);
+            if(num_seen < sizeof(seen) / sizeof(seen[0]))
+                seen[num_seen++] = hash;
+        }
+    } else if(!current_valid || hash != current) {
+        gsr_cursor_track_printf("{\"t\":%.6f,\"shape\":\"%016" PRIx64 "\"}", t, hash);
+    }
+    current = hash;
+    current_valid = true;
+    free(rgba);
+}
+
+static void cursor_track_buffer(struct spa_buffer *buffer) {
+    static bool known = false;
+    static bool visible = false;
+    static int32_t last_x = 0, last_y = 0;
+    static struct spa_region last_crop;
+    static bool crop_known = false;
+
+    const double t = clock_get_monotonic_seconds();
+
+    const struct spa_meta_region *crop = spa_buffer_find_meta_data(buffer, SPA_META_VideoCrop, sizeof(*crop));
+    const bool crop_valid = crop && spa_meta_region_is_valid(crop);
+    if(crop_valid && (!crop_known || memcmp(&crop->region, &last_crop, sizeof(last_crop)) != 0)) {
+        gsr_cursor_track_printf("{\"t\":%.6f,\"crop\":[%d,%d,%u,%u]}", t,
+            crop->region.position.x, crop->region.position.y, crop->region.size.width, crop->region.size.height);
+        last_crop = crop->region;
+        crop_known = true;
+    }
+
+    const struct spa_meta_cursor *cursor = spa_buffer_find_meta_data(buffer, SPA_META_Cursor, sizeof(*cursor));
+    if(!cursor)
+        return;
+
+    if(!spa_meta_cursor_is_valid(cursor)) {
+        /* No cursor on this stream right now (on another output, or off the window) */
+        if(!known || visible)
+            gsr_cursor_track_printf("{\"t\":%.6f,\"hidden\":true}", t);
+        known = true;
+        visible = false;
+        return;
+    }
+
+    if(cursor->bitmap_offset >= sizeof(*cursor)) {
+        const struct spa_meta_bitmap *bitmap = SPA_MEMBER(cursor, cursor->bitmap_offset, struct spa_meta_bitmap);
+        cursor_track_shape(t, cursor, bitmap);
+    }
+
+    if(!known || !visible || cursor->position.x != last_x || cursor->position.y != last_y)
+        gsr_cursor_track_printf("{\"t\":%.6f,\"x\":%d,\"y\":%d}", t, cursor->position.x, cursor->position.y);
+    known = true;
+    visible = true;
+    last_x = cursor->position.x;
+    last_y = cursor->position.y;
+}
+
