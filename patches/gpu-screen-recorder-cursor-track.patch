 #include <xf86drmMode.h>
 #include <xf86drm.h>
@@ -22,6 +24,38 @@
 
 #define DRM_NUM_BUF_ATTRS 4
 
+static pthread_once_t cursor_track_once = PTHREAD_ONCE_INIT;
+static pthread_mutex_t cursor_track_mutex = PTHREAD_MUTEX_INITIALIZER;
+static FILE *cursor_track_file = NULL;
+
+static void cursor_track_open(void) {
+    const char *path = getenv("GSR_CURSOR_TRACK");
+    if(!path || path[0] == '\0')
+        return;
+    cursor_track_file = fopen(path, "we");
+    if(!cursor_track_file)
+        fprintf(stderr, "gsr error: cursor track: failed to open %s: %s\n", path, strerror(errno));
+}
+
+bool gsr_cursor_track_enabled(void) {
+    pthread_once(&cursor_track_once, cursor_track_open);
+    return cursor_track_file != NULL;
+}
+
+void gsr_cursor_track_printf(const char *fmt, ...) {
+    if(!gsr_cursor_track_enabled())
+        return;
+    pthread_mutex_lock(&cursor_track_mutex);
+    va_list args;
+    va_start(args, fmt);
+    vfprintf(cursor_track_file, fmt, args);
+    va_end(args);
+    fputc('\n', cursor_track_file);
+    /* Line by line, so a crash keeps everything up to it */
+    fflush(cursor_track_file);
+    pthread_mutex_unlock(&cursor_track_mutex);
+}
+
 double clock_get_monotonic_seconds(void) {
     struct timespec ts;
     ts.tv_sec = 0;
